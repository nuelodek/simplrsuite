Options -Indexes -MultiViews
DirectoryIndex disabled
RewriteEngine On
RewriteRule (^|/)\. - [R=404,L]
RewriteRule (^|/)(uploads|attachments|resumes|profile_pictures)(/|$) - [R=404,L,NC]
RewriteRule ^(404\.html|users/admin/login\.html|users/developers/documentation\.html)$ - [END]
RewriteRule ^(public/(styles|scripts|images)|scripts|styles|images|img|css|assets)/[a-zA-Z0-9_./\ -]+\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf)$ - [END]
RewriteRule ^public-entry\.php$ - [END]
RewriteRule ^ public-entry.php [END,QSA]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
