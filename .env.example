APP_ENV=production
APP_URL=https://your-simplr-domain.example
# Set these origins when the three promotional domains are ready on your host.
APP_BUSINESS_URL=
APP_TALENT_URL=
APP_WORK_URL=
APP_TIMEZONE=Africa/Lagos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simplr
DB_USERNAME=simplr
DB_PASSWORD=
MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Simplr Suite
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Social job publishing: add provider credentials here before enabling direct job sync.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Paystack: use newly issued keys. Never reuse secrets from source history.
PAYSTACK_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
# Flutterwave v3 USD checkout uses the same test/live mode as PAYSTACK_MODE.
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Original simplr24 fallback rate, now an explicit server-owned fixed rate.
# USD per NGN. Review this business price conversion before going live.
BILLING_USD_RATE=0.00063
# Set true only when ready to enforce paid editing; reads remain available.
BILLING_ENFORCE=false

# Owner-reviewed privacy notice; do not mark approved before review.
PRIVACY_APPROVED=false
PRIVACY_LEGAL_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_BUSINESS_ADDRESS=
PRIVACY_CONTACT_PHONE=
PRIVACY_REVIEWED_ON=
